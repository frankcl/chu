# Copy to .env and fill in your keys

# LLM backend: "anthropic" (default), "openai", or "qwen"
LLM_PROVIDER=anthropic

# Model name (optional, uses sensible defaults per provider)
# Anthropic default: claude-sonnet-4-6
# OpenAI default:    gpt-4o
# Qwen default:      qwen-plus  (options: qwen-turbo, qwen-plus, qwen-max)
MODEL_NAME=qwen3-max

# API keys
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# DASHSCOPE_API_KEY=your_key_here
# TAVILY_API_KEY=your_key_here

# Enable thinking/reasoning mode (anthropic: requires claude-sonnet-4-5+; qwen: requires qwen3-*)
# Note: qwen3-* models enable thinking by default without this flag
# ENABLE_THINKING=true

# Logging level: DEBUG / INFO (default) / WARNING / ERROR
# LOG_LEVEL=INFO

# Hylian SSO 接入（hylian-client-py）
# 在 hylian 后台注册本应用获得 app_id/app_secret；server_url 指向 hylian-server（9001 HTTPS）
HYLIAN_APP_ID=your_app_id
HYLIAN_APP_SECRET=your_app_secret
HYLIAN_SERVER_URL=https://hylian.manong.xin:9001/
HYLIAN_VERIFY_TLS=false            # 自签证书时关闭校验
# shield sid cookie（HYLIAN_SESSION）：本地 http 需置 false，生产 https 保持 true
HYLIAN_SESSION_COOKIE_SECURE=false
# 放行（免鉴权）路径：验证码/登录/登出、文件下载、PPT 主题预览（/api/auth/me 受保护）
HYLIAN_EXCLUDE_PATTERNS=["/api/auth/captcha","/api/auth/login","/api/auth/logout","/api/files/*","/api/ppt/themes"]

# 阿里云 OSS：用于对用户头像加签（私有读临时访问 URL）。缺任一项则不加签、头像原样返回。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your_bucket_name
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_URL_EXPIRE_SECONDS=3600         # 加签 URL 有效期（秒）

# MySQL：对话历史持久化（分用户存储）。缺关键项则禁用历史功能、不阻断对话。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=chu
# 或用整串覆盖上面各项：DATABASE_URL=mysql+pymysql://user:pwd@host:3306/db?charset=utf8mb4

# Harness 控制（注释行展示的是默认值；可在创建 session 时通过 API 逐项覆盖）
# RECURSION_LIMIT=25                  # LangGraph 节点循环上限
# IDLE_TIMEOUT_SECONDS=60             # 距离上次 SSE 事件超过此秒数才中止；持续产出的会话不受总时长限制
# PER_TOOL_TIMEOUT_SECONDS=30         # 单个工具调用最长耗时
# MAX_TOOL_CALLS=20                   # 单次请求最多工具调用次数
# MAX_TOOL_CALLS_PER_TASK=8           # 任务级别单次请求最多工具调用次数
# MAX_SKILL_SCRIPT_CALLS=3            # 单轮内同一 skill 脚本(如 web-research 搜索)最多运行次数，超限优雅拒绝
# MAX_SKILL_SCRIPT_CALLS_PER_TASK=3   # 任务级别同一 skill 脚本(如 web-research 搜索)最多运行次数，超限优雅拒绝
# MAX_SKILL_SCRIPT_CALLS_OVERRIDES=ppt/build.py=2,web-research/search.py=4  # 针对特定脚本单独设上限，覆盖上面的全局值(逗号分隔的 skill/script=次数)。内置默认 ppt/build.py=2
# MAX_TOKENS_BUDGET=200000            # 单次请求 LLM token 总预算
# LLM_MAX_RETRIES=2                   # LLM 调用瞬时错误的额外重试次数
# MEMORY_MAX_TOKENS=24000             # 短期记忆达到此估算 token 数时触发压缩
# MEMORY_TARGET_TOKENS=12000          # 压缩后的目标 token 数
# MEMORY_KEEP_RECENT_TURNS=4          # 压缩时优先完整保留的最近对话轮数
# MEMORY_SUMMARY_CONTEXT_TOKENS=128000 # summary 模型单次请求的总 context；会预留输出及估算余量
# MEMORY_TTL_SECONDS=3600             # 运行时会话的滑动有效期；不删除 MySQL 历史
# MEMORY_SWEEP_INTERVAL_SECONDS=60    # 后台清理过期运行时会话的扫描间隔
# TOOL_ALLOWLIST=                     # 逗号分隔；非空时仅这些工具可用
# TOOL_DENYLIST=                      # 逗号分隔；优先级高于 allowlist
